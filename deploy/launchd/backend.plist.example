<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example: a typed-decision model server as a launchd user agent on 127.0.0.1:8117, behind decisions-gateway
  (the counterpart of deploy/systemd/backend.service.example). This is an example for your own server, not
  something the project ships: adapt ProgramArguments to your server's command line, then replace the
  placeholders, by hand or with deploy/render-launchd.sh:
    @HOME@         the account's home directory
    @BACKEND_DIR@  absolute path of the server program
    @MODEL_DIR@    absolute path of the model weights

  The gateway expects the server to answer GET /health without auth (JSON with optional "status", "model"
  and "fingerprint" fields) and POST /v1/systemone with a Bearer key. By default the gateway presents its own
  key, so the server can read DECISIONS_GATEWAY_API_KEY from ~/.config/decisions-gateway/key.env itself
  (launchd has no EnvironmentFile; keep keys out of this plist and out of argv).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>decisions-backend</string>
  <key>ProgramArguments</key>
  <array>
    <string>@BACKEND_DIR@/serve</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8117</string>
    <string>--model-dir</string>
    <string>@MODEL_DIR@</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@BACKEND_DIR@</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>3</integer>
  <!-- Below interactive work, as Nice=5 in the systemd example. launchd has no CPUQuota or MemoryMax:
       a CPU-bound server can heat a laptop, so prefer a GPU runtime or cap concurrency in the gateway. -->
  <key>Nice</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Standard</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>SoftResourceLimits</key>
  <dict>
    <key>Core</key>
    <integer>0</integer>
  </dict>
  <key>HardResourceLimits</key>
  <dict>
    <key>Core</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/decisions-gateway/backend.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/decisions-gateway/backend.log</string>
</dict>
</plist>
